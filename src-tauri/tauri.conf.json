{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "excalidraw-local",
  "version": "1.0.0",
  "identifier": "dev.manan.excalidraw-local",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
